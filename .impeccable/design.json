  "narrative": {
    "northStar": "The Signal Code",
    "overview": "Rallypoint reads like a published code of signals for coding agents. Every role carries one square signal flag drawn in the geometry of the International Code of Signals, every state is a GitHub label rendered exactly as GitHub renders it, and every mechanism is drawn as a schematic from protocol facts — never illustrated. The page is a code book, not a pitch deck: cool white ground, ink hairline rules, compressed grotesque headlines, and tables where other sites put cards. Colour arrives at page scale in two drenched bands — the claim on signal yellow, the proof on signal blue.",
    "keyCharacteristics": [
      "Zero raster illustration. Diagrams are inline SVG or real HTML UI built from protocol facts.",
      "Five signal inks, used whole: red, yellow, blue, black, white.",
      "Compressed Archivo for display, Martian Mono only for code, refs, paths and commands.",
      "Tables, rules and schematics instead of card grids.",
      "Demonstration data is labelled (\"Illustrative run · real commands\"); claims are never invented."
    ],
    "rules": [
      {
        "name": "The Whole-Ink Rule",
        "body": "Signal colours are used at full strength in flags, chips, bands and diagram lines — never tinted into washes, gradients or glows.",
        "section": "colors"
      },
      {
        "name": "The Never-Alone Rule",
        "body": "A flag or chip is always printed beside its role or label name. Colour never carries meaning by itself.",
        "section": "colors"
      },
      {
        "name": "The Two-Band Rule",
        "body": "A page drenches at most two regions in signal colour; everything else is paper.",
        "section": "colors"
      },
      {
        "name": "The Mono-Means-Code Rule",
        "body": "Martian Mono appears only for things a person could paste: commands, paths, refs, config keys, agent ids.",
        "section": "typography"
      },
      {
        "name": "The No-Kicker Rule",
        "body": "No eyebrow labels above headings. A heading carries its own weight.",
        "section": "typography"
      },
      {
        "name": "The Flat-Ground Rule",
        "body": "No box-shadows, no glows. If something needs to stand forward, change its ground or its rule.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw mechanisms from protocol facts: label names, ref paths, commands and exit behaviour exactly as the installed files define them.",
      "Do label synthetic demonstration data on the surface where it appears.",
      "Do pair every flag and chip with its name.",
      "Do keep colour whole — full-strength signal inks in flags, chips, lines and bands.",
      "Do use tables and ruled lists for structured comparisons."
    ],
    "donts": [
      "Don't use AI-generated or painted illustration, parchment, maps, or fantasy trade dress.",
      "Don't add shadows, glows, gradients or glass.",
      "Don't set eyebrow kickers above headings or tracked-caps labels.",
      "Don't use Martian Mono for anything that is not literally code.",
      "Don't build sections out of rows of identical icon cards."
    ]
  }
}