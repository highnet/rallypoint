# Rallypoint Swarm UI. Copy to .env.local and fill in.
# The UI only reads. It never writes to Supabase or GitHub.

# Your own Supabase project's URL (Project settings > API).
NEXT_PUBLIC_RALLYPOINT_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable (anon) key. Safe to expose: read-only RLS decides what it
# can see. Never put the service-role key or RALLYPOINT_SWARM_SECRET here.
NEXT_PUBLIC_RALLYPOINT_SUPABASE_KEY=

# The repository the swarm works in, as owner/name. Powers the Rallypoint
# lanes, delivery progress, merged PRs in News, and the Skills page.
RALLYPOINT_GITHUB_REPO=

# Optional. A GitHub token with read access, used server-side only: raises
# the rate limit and lets the UI read a private repository.
RALLYPOINT_GITHUB_TOKEN=

# Optional. GitHub Enterprise Server only: its API base URL.
# RALLYPOINT_GITHUB_API_URL=https://ghe.example.com/api/v3
